const authService = require('../Logic/UserRepository');

class AuthController {
    
    // Login de usuario
    async login(req, res) {
        try {

            const { usuario, password } = req.body; // las varibales par ael post

            const userData = await authService.login(usuario, password); // se almacena en una const para que espere la funcion login

            const response = {// respuesta del servidor
                success: true,
                message: "Login exitoso",
                user: userData  
            };

            res.status(200).json(response)// estatus del sevidor
            console.log('Login completado exitosamente');

        } catch (error) {
            console.error('Error en AuthController.login:', error.message);

            let statusCode = 500;// estados de error
            if (error.message.includes('requeridos') || error.message.includes('vacíos')) {//validaciones de errores
                statusCode = 400;
            } else if (error.message.includes('Credenciales incorrectas')) {//validacion credenciales
                statusCode = 401;// estado error
            }

            res.status(statusCode).json({
                success: false,
                message: error.message
            });
        }
    }

    // funcion que termina la creacion del usuario, este para hacer el Post desde el controller 
    async register(req, res) {
        try {
            const { usuario, password } = req.body;// el body para el post

            const userData = await authService.register(usuario, password);// espereamos la funcion register 

            const response = {// respuesta del servidor al momento de el register sea correcto
                success: true,
                message: "Usuario registrado exitosamente",
                user: userData
            };

            res.status(201).json(response);
            console.log('Registro completado exitosamente para:', usuario);

        } catch (error) {
            console.error('Error en AuthController.register:', error.message);

            let statusCode = 500;
            if (error.message.includes('requeridos') || 
                error.message.includes('vacíos') || 
                error.message.includes('caracteres')) {// los mensajes de error qe lanazara si las validaciones no son correctas
                statusCode = 400;
            } else if (error.message.includes('ya existe')) {// en dado caso exista ya el usuario en labase de datos, lanza une error
                statusCode = 409; // Conflicto
            }

            res.status(statusCode).json({
                success: false,
                message: error.message
            });
        }
    }

  
}

module.exports = new AuthController();